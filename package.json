{
  "name": "duckai-api-server",
  "version": "1.0.0",
  "description": "High-performance OpenAI-compatible HTTP API Gateway and Playground for Duck.ai",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/test-api.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "duckai",
    "duckduckgo",
    "openai",
    "api",
    "gpt-6",
    "claude",
    "mistral",
    "gemma"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.14.0"
  }
}
