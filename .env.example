# DuckAI API Server Configuration
PORT=3000
HOST=0.0.0.0

# Pool & Worker Settings (Cada worker consome ~350MB-500MB de RAM)
POOL_SIZE=2
DEFAULT_MODEL=deepseek-chat
DAILY_QUOTA=150
REQUEST_TIMEOUT_MS=60000

# Chrome Executable Path:
# - No Docker / Linux: O sistema detecta automaticamente (/usr/bin/google-chrome-stable)
# - No Windows Local: C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Headless mode: 'true' (obrigatório em servidores Docker sem interface gráfica) ou 'false' (janela visível no desktop)
HEADLESS=true

# Opcional: Chave de API de segurança (se configurada, exige Authorization: Bearer <chave> ou cabeçalho x-api-key)
# API_KEY=sua-chave-secreta

