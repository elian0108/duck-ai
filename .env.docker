# ==============================================================================
# DuckAI API Gateway - Configurações do Ambiente Docker (Servidor Linux)
# ==============================================================================

# Porta exposta no host
PORT=3000

# Host de escuta interno (0.0.0.0 para escutar dentro do container)
HOST=0.0.0.0

# Quantidade de workers simultâneos no pool do Chrome (Recomendado: 2 a 4 dependendo da RAM)
# 2 workers consomem aproximadamente ~700MB a 1GB de RAM
POOL_SIZE=2

# Modelo padrão caso nenhum seja informado
DEFAULT_MODEL=deepseek-chat

# Cota diária estimada e monitoramento de capacidade
DAILY_QUOTA=150

# Timeout de requisições em milissegundos (padrão: 60s)
REQUEST_TIMEOUT_MS=60000

# Modo Headless (OBRIGATÓRIO 'true' no servidor sem interface gráfica)
HEADLESS=true

# Chave de segurança opcional para proteger sua API na Internet
# Se definida, as requisições exigirão 'Authorization: Bearer <sua-chave>' ou cabeçalho 'x-api-key'
# API_KEY=sua-chave-secreta-aqui
